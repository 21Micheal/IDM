# ──────────────────────────────────────────────────────────────────────────────
# UAT environment — copy to .env.uat ON THE SERVER and fill in real values.
#   cp .env.uat.example .env.uat
# .env.uat is gitignored; never commit real secrets.
#
# Replace every CHANGE_ME and the idm-uat hostname before going live.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
DEBUG=False
# Generate one with:
#   docker run --rm idm-app:uat python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# (or any 50+ char random string)
SECRET_KEY=CHANGE_ME_long_random_50_chars

# The hostname(s) testers will use. Comma-separated, NO scheme/port.
# Include the bare hostname AND the FQDN so both resolve.
ALLOWED_HOSTS=idm-uat,idm-uat.company.local,localhost,127.0.0.1

# Must include scheme + host, used for Django admin / form POSTs over HTTP.
CSRF_TRUSTED_ORIGINS=http://idm-uat,http://idm-uat.company.local

# Same-origin deployment → CORS is unused, but harmless to keep aligned.
CORS_ALLOWED_ORIGINS=http://idm-uat,http://idm-uat.company.local

# ── Datastore credentials (used by docker-compose.uat.yml interpolation) ──────
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── OCR / IDP ─────────────────────────────────────────────────────────────────
# Engine: paddle (default, on-box, no API key) | tesseract | textract
OCR_ENGINE=paddle
# Optional: AI-assisted field extraction. Leave blank to disable.
ANTHROPIC_API_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────────
# Default console backend just logs emails. Point at your internal SMTP relay
# to actually send workflow notifications during UAT.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dms@company.local
