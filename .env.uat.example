# ──────────────────────────────────────────────────────────────────────────────
# UAT environment — copy to .env.uat ON THE SERVER and fill in real values.
#   cp .env.uat.example .env.uat
# .env.uat is gitignored; never commit real secrets.
#
# Replace every CHANGE_ME and the fsedms hostname before going live.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
DEBUG=False
# HTTP-only UAT: disable the automatic HTTPS redirect + secure-only cookies that
# Django turns on when DEBUG=False. Set back to True once TLS terminates at nginx.
SECURE_SSL=False
# Generate one with:
#   docker run --rm idm-app:uat python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# (or any 50+ char random string)
SECRET_KEY=CHANGE_ME_long_random_50_chars

# The hostname(s) testers will use. Comma-separated, NO scheme/port.
# Include the bare hostname AND the FQDN so both resolve.
ALLOWED_HOSTS=fsedms,fsedms.company.local,localhost,127.0.0.1

# Must include scheme + host, used for Django admin / form POSTs over HTTP.
CSRF_TRUSTED_ORIGINS=http://fsedms,http://fsedms.company.local

# Same-origin deployment → CORS is unused, but harmless to keep aligned.
CORS_ALLOWED_ORIGINS=http://fsedms,http://fsedms.company.local

# ── Datastore credentials (used by docker-compose.uat.yml interpolation) ──────
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── OCR / IDP (AI document extraction) ───────────────────────────────────────
# Local raster engine: paddle (default, on-box, no API key) | tesseract | textract
OCR_ENGINE=paddle
# Paste your real key to enable AI field extraction. Leave blank to fall back to
# the local OCR+regex pipeline (no API cost). This is the ONLY var the IDP
# feature requires — the overrides below all default to these same values.
ANTHROPIC_API_KEY=
# Optional IDP overrides (defaults shown — uncomment only to change them):
#IDP_PROVIDER=anthropic            # anthropic | regex
#OCR_IDP_ENGINE=auto               # auto | vision | text | regex
#OCR_IDP_MODEL=claude-haiku-4-5    # or claude-sonnet-4-6 (more accurate, ~8x cost)
#OCR_IDP_MAX_PAGES=3               # pages sent per doc (cost/latency control)

# ── Email (REQUIRED) ──────────────────────────────────────────────────────────
# Login sends a one-time code by email (MFA), so mail MUST work or no one can
# sign in. An internal server usually can't reach Gmail — use your company's
# internal mail relay (ask IT). Two common shapes:
#   • Anonymous internal relay : EMAIL_PORT=25,  EMAIL_USE_TLS=False, no creds
#   • Authenticated submission : EMAIL_PORT=587, EMAIL_USE_TLS=True,  service acct
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.company.local
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use an internal-domain From, or the relay may reject the message:
DEFAULT_FROM_EMAIL=FlaxemDMS <dms@company.local>
#
# Stuck without a relay? Temporary solo-testing fallback — OTP prints to
# `docker compose ... logs backend` instead of being emailed:
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Active Directory / LDAP login (optional) ──────────────────────────────────
# Set LDAP_SERVER_URI to let testers authenticate against AD during UAT.
#LDAP_SERVER_URI=ldap://dc.company.local
#LDAP_BIND_DN=
#LDAP_BIND_PASSWORD=
#LDAP_USER_SEARCH_BASE=ou=users,dc=company,dc=local

# ── Office-preview tuning (optional; defaults are fine) ───────────────────────
#LIBREOFFICE_TIMEOUT=120
#PREVIEW_PROCESSING_STALE_SECONDS=300
