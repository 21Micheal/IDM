# Copy to .env on the deployment host and replace the example values.
# Keep .env private and out of source control.

DEBUG=False
# HTTPS terminates in the bundled nginx container. Put fullchain.pem and
# privkey.pem in TLS_CERT_DIR before starting the full stack.
SECURE_SSL=True
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_DJANGO_SECRET

# Hostname users will enter in their browser (no scheme or port).
ALLOWED_HOSTS=procurement.example.local,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://procurement.example.local
FRONTEND_URL=https://procurement.example.local
HTTP_PORT=80
HTTPS_PORT=443
# Directory on the Ubuntu VM containing fullchain.pem and privkey.pem.
TLS_CERT_DIR=/home/ubuntu/certs/procurement

# Generate separate, strong passwords. Use URL-safe alphanumeric characters for
# REDIS_PASSWORD because it is embedded in REDIS_URL.
PGPASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_REDIS_PASSWORD

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.local
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Procurement <procurement@example.local>

# Optional SunSystems integration
SUNSYSTEMS_BASE_URL=
SUNSYSTEMS_USERNAME=
SUNSYSTEMS_PASSWORD=
SUNSYSTEMS_BUSINESS_UNIT=
SUNSYSTEMS_BUDGET_CODE=A
SUNSYSTEMS_VERIFY_TLS=True
