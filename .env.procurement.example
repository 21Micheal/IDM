# Copy to /opt/flaxem/config/.env on the deployment host and replace the
# example values. Keep this file private and out of source control.

DEBUG=False
# HTTP on port 8080. This must be False unless HTTPS is configured in front.
SECURE_SSL=False
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_DJANGO_SECRET

# Hostname or server IP users will enter in their browser (no scheme or port).
ALLOWED_HOSTS=192.168.0.10,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://192.168.0.10:8080
FRONTEND_URL=http://192.168.0.10:8080
HTTP_PORT=8080

# Generate separate, strong passwords. Use URL-safe alphanumeric characters for
# REDIS_PASSWORD because it is embedded in REDIS_URL.
PGPASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_REDIS_PASSWORD

EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
# True enables STARTTLS with Django's SMTP backend.
EMAIL_USE_TLS=True
# OAuth2 uses Microsoft Entra client credentials and SMTP XOAUTH2.
EMAIL_AUTH_METHOD=oauth2
EMAIL_HOST_USER=
EMAIL_OAUTH_TENANT_ID=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_SCOPE=https://outlook.office365.com/.default
DEFAULT_FROM_EMAIL=EAC Travel REQ <sender@example.com>

# Optional SunSystems integration
SUNSYSTEMS_BASE_URL=
SUNSYSTEMS_HOST_IP=192.168.0.7
SUNSYSTEMS_USERNAME=
SUNSYSTEMS_PASSWORD=
SUNSYSTEMS_BUSINESS_UNIT=
SUNSYSTEMS_BUDGET_CODE=A
SUNSYSTEMS_VERIFY_TLS=True

# Optional integrations. Keep blank unless this deployment uses them.
CORS_ALLOWED_ORIGINS=
SUNSYSTEMS_SECURITY_PATH=SecurityProvider
SUNSYSTEMS_EXECUTOR_PATH=ComponentExecutor
SUNSYSTEMS_BUDGET_STUB=True
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=True
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_VERIFY_TLS=True
IMAP_POLL_INTERVAL_SECONDS=300
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_FOLDER=inbox
GRAPH_VERIFY_TLS=True
FLAXEM_OPS_ALERT_EMAIL=
