# Copy to /opt/flaxem/config/.env on the deployment host and replace the
# example values. Keep this file private and out of source control.

DEBUG=False
# Initial deployment uses HTTP on port 8080. Set SECURE_SSL=True only after
# HTTPS is configured in front of the application.
SECURE_SSL=False
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_DJANGO_SECRET

# Hostname or server IP users will enter in their browser (no scheme or port).
ALLOWED_HOSTS=192.168.0.10,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://192.168.0.10:8080
FRONTEND_URL=http://192.168.0.10:8080
HTTP_PORT=8080

# Generate separate, strong passwords. Use URL-safe alphanumeric characters for
# REDIS_PASSWORD because it is embedded in REDIS_URL.
PGPASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_REDIS_PASSWORD

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.local
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Procurement <procurement@example.local>

# Optional SunSystems integration
SUNSYSTEMS_BASE_URL=
SUNSYSTEMS_USERNAME=
SUNSYSTEMS_PASSWORD=
SUNSYSTEMS_BUSINESS_UNIT=
SUNSYSTEMS_BUDGET_CODE=A
SUNSYSTEMS_VERIFY_TLS=True
