# ──────────────────────────────────────────────────────────────────────────────
# Native Windows install — copy to .env and fill in real values.
#   copy .env.windows.example .env
#
# NOTE: use FORWARD SLASHES in Windows paths (C:/IDM/media). Python accepts them
# and it avoids backslash-escaping surprises in the .env parser.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
DEBUG=False
# HTTP-only LAN install: disable the auto HTTPS redirect + secure-only cookies.
SECURE_SSL=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=CHANGE_ME_long_random_50_chars

# How users reach the system (server IP and/or hostname). NO scheme/port.
ALLOWED_HOSTS=192.168.100.244,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://192.168.100.244
CORS_ALLOWED_ORIGINS=http://192.168.100.244
# Public base URL used in outgoing email links (welcome, OTP-context, workflow).
FRONTEND_URL=http://192.168.100.244

# ── Database — Microsoft SQL Server ───────────────────────────────────────────
DB_ENGINE=mssql
DB_NAME=idm_db
# SQL auth: set USER + PASSWORD.  Windows/trusted auth: leave both blank and set
# DB_EXTRA_PARAMS=Trusted_Connection=yes below.
DB_USER=idm_user
DB_PASSWORD=CHANGE_ME_db_password
# Host examples: localhost  |  .\SQLEXPRESS  |  SERVERNAME\INSTANCE  |  127.0.0.1
DB_HOST=localhost
DB_PORT=
# Use whichever driver is installed: "ODBC Driver 17 for SQL Server" or
# "ODBC Driver 18 for SQL Server". Both work. Driver 18 defaults Encrypt=yes
# (needs TrustServerCertificate for a self-signed cert); Driver 17 defaults
# Encrypt=no, so the extra param below is usually unnecessary with 17.
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Driver 18 self-signed cert: keep this. Driver 17: harmless to leave. Windows
# auth instead: DB_EXTRA_PARAMS=Trusted_Connection=yes;TrustServerCertificate=yes
DB_EXTRA_PARAMS=TrustServerCertificate=yes

# ── Redis (any Redis-compatible Windows service) ──────────────────────────────
# Options: free Redis-for-Windows (tporadowski) · Memurai · etc. Drop-in via this
# URL. If the service has a password: redis://:YOUR_PASSWORD@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Search ────────────────────────────────────────────────────────────────────
# Elasticsearch off → search falls back to the database. No ES server needed.
ELASTICSEARCH_ENABLED=False

# ── Media / storage ───────────────────────────────────────────────────────────
MEDIA_ROOT=C:/IDM/media
SERVE_MEDIA_PUBLIC=False
# Soft storage allowance (GB) shown on the dashboard. Reporting only.
#STORAGE_QUOTA_GB=50

# ── Office previews (LibreOffice) ─────────────────────────────────────────────
LIBREOFFICE_CMD=C:/Program Files/LibreOffice/program/soffice.exe
LIBREOFFICE_BIN=C:/Program Files/LibreOffice/program/soffice.exe
# Warm, reusable profile → faster Office previews (created on first use).
LIBREOFFICE_PROFILE_DIR=C:/IDM/lo-profile
LIBREOFFICE_TIMEOUT=120

# ── OCR ───────────────────────────────────────────────────────────────────────
# paddle (on-box, no key) | tesseract | textract
OCR_ENGINE=paddle
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# NOTE: poppler (for PDF→image) must be on the system PATH — pdf2image finds it
# there. Install poppler-windows and add its \bin folder to PATH.

# ── AI document extraction (optional; needs outbound internet) ────────────────
ANTHROPIC_API_KEY=

# ── Email (REQUIRED — login sends an OTP, so mail must work) ───────────────────
# Use the company's internal SMTP relay (no internet needed). Console backend
# below just logs the OTP for solo testing.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.company.local
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FlaxemDMS <dms@company.local>
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── AD / LDAP login (optional) ────────────────────────────────────────────────
# Needs python-ldap installed (prebuilt Windows wheel). Leave blank to disable.
#LDAP_SERVER_URI=ldap://dc.company.local
