# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL deployment — copy to .env and fill in real values.
#   cp .env.postgres.example .env
#
# Used with the Docker Compose overlay:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
#
# For a bare-metal / non-Docker PostgreSQL install, set these same variables
# in your shell environment or a .env file and run manage.py directly.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-in-production

# ── Database — PostgreSQL ─────────────────────────────────────────────────────
# Select the PostgreSQL backend. Accepted values: postgres | postgresql | pgsql
DB_ENGINE=postgres

# Option A: discrete connection variables (recommended for Docker deployments,
# consistent with the SQL Server style in .env.windows.example)
# When using the Compose overlay, DB_HOST must be "postgres" (the Docker service name).
# For bare-metal PostgreSQL, use "localhost" or the actual hostname instead.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=idm_db
DB_USER=idm_user
DB_PASSWORD=CHANGE_ME_db_password

# Option B: DATABASE_URL (alternative to the discrete vars above; use one or
# the other — DATABASE_URL takes priority if both are set).
# DATABASE_URL=postgresql://idm_user:CHANGE_ME@localhost:5432/idm_db

# Docker Compose overlay credentials (used for POSTGRES_PASSWORD interpolation)
PGPASSWORD=CHANGE_ME_db_password
PGROOT_PASSWORD=CHANGE_ME_root_password

# Optional: persistent connection pool lifetime in seconds (default 600)
# DB_CONN_MAX_AGE=600

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379/0

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
# Set to False to disable Elasticsearch and fall back to DB search.
# ELASTICSEARCH_ENABLED=True

# ── CORS / Hosts ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,nginx

# ── Media ─────────────────────────────────────────────────────────────────────
MEDIA_ROOT=/app/media
SERVE_MEDIA_PUBLIC=False

# ── S3 (optional) ─────────────────────────────────────────────────────────────
USE_S3=False
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1

# ── LDAP / Active Directory (optional) ───────────────────────────────────────
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com

# ── OCR engine ────────────────────────────────────────────────────────────────
OCR_ENGINE=paddle
OCR_LANGUAGES=eng
OCR_DPI=300

# ── Email (optional — OTP login requires working mail in production) ──────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dms@example.com

# ── AI document extraction (optional) ────────────────────────────────────────
ANTHROPIC_API_KEY=
